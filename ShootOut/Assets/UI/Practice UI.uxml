<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="button_panel" src="project://database/Assets/UI/button-panel.uxml?fileID=9197481963319205126&amp;guid=73fa79bdeb5310442908db34e8492f20&amp;type=3#button-panel"/>
    <ui:Template name="power-slider" src="project://database/Assets/UI/power-slider.uxml?fileID=9197481963319205126&amp;guid=beb5c4c8f20d8ff4dae68345bf6cc0e3&amp;type=3#power-slider"/>
    <Style src="project://database/Assets/UI/ControlUI.uss?fileID=7433441132597879392&amp;guid=a42d7049e045f5542a9d966f78691ed7&amp;type=3#ControlUI"/>
    <ui:VisualElement name="main-panel" style="flex-grow: 1; justify-content: space-between;">
        <ui:VisualElement name="top-panel" style="flex-grow: 1; flex-direction: row; height: 720px; max-height: 60%; justify-content: space-between;">
            <ui:VisualElement name="cpu-panel" style="flex-grow: 1; max-width: 60%;">
                <ui:Button text="상대 조작" name="toggle-visibility" style="align-self: flex-start; width: 300px; height: 100px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-right: 10px; padding-left: 10px; font-size: 60px;"/>
                <ui:VisualElement name="cpu-control-panel" enabled="false" style="height: 610px; align-self: flex-start; width: 488px; align-items: stretch; justify-content: space-between; align-content: flex-start; aspect-ratio: 0.75; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; left: 30px; visibility: hidden;">
                    <ui:Instance template="button_panel" name="cpu-button-panel"/>
                    <ui:Instance template="power-slider" name="cpu-power-slider"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="종료" name="quit-button" style="width: 160px; height: 100px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-right: 10px; padding-left: 10px; font-size: 60px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="player-control-panel" style="height: 610px; align-self: flex-end; width: 488px; align-items: stretch; justify-content: space-between; align-content: flex-start; aspect-ratio: 0.75; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; right: 30px; bottom: 30px;">
            <ui:Instance template="button_panel" name="player-button-panel"/>
            <ui:Instance template="power-slider" name="player-power-slider"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
