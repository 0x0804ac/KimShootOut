<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-panel" style="flex-grow: 1; justify-content: center;">
        <ui:VisualElement name="top-panel" style="height: 100px; flex-direction: row; justify-content: space-between;">
            <ui:VisualElement name="title-panel" style="margin-top: 20px; margin-left: 20px; margin-right: 20px; border-top-left-radius: 32px; border-top-right-radius: 32px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 0; border-left-width: 8px; background-color: rgb(255, 240, 184); border-left-color: rgb(217, 180, 45); border-right-color: rgb(217, 180, 45); border-top-color: rgb(217, 180, 45); border-bottom-color: rgb(217, 180, 45); align-self: flex-start; justify-content: center; left: 34px;">
                <ui:Label text="튜토리얼" name="title-label" style="font-size: 50px; -unity-text-align: middle-center; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
            <ui:Button text="확인" name="confirm-button" style="right: 34px; font-size: 50px; margin-top: 16px; margin-right: 0; margin-bottom: 4px; margin-left: 0; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-left-radius: 32px; border-top-right-radius: 32px; border-bottom-right-radius: 32px; border-bottom-left-radius: 32px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="dialog-panel" style="height: 480px; margin-top: 0; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; background-color: rgb(255, 240, 184); border-left-color: rgb(217, 180, 45); border-right-color: rgb(217, 180, 45); border-top-color: rgb(217, 180, 45); border-bottom-color: rgb(217, 180, 45); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px; border-top-left-radius: 32px; border-top-right-radius: 32px; border-bottom-right-radius: 32px; border-bottom-left-radius: 32px;">
            <ui:Label text="이것저것 설명&#10;아아아아아아아아아아&#10;여러줄테스트" name="title-label" style="font-size: 50px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
