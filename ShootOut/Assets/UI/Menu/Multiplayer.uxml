<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-panel" style="flex-grow: 1; margin-top: 60px; margin-right: 60px; margin-bottom: 60px; margin-left: 60px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; -unity-text-align: middle-center;">
        <ui:Label text="Shoot-Out" name="title-label" style="justify-content: center; align-content: center; font-size: 144px; margin-left: 4px; margin-bottom: 400px; margin-top: 100px; margin-right: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;"/>
        <ui:Label text="멀티플레이" name="menu-label" style="padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; font-size: 108px; margin-left: 4px; margin-bottom: 100px;"/>
        <ui:GroupBox name="button-group" style="margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
            <ui:Button text="특별 게임 모드" name="event-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="일반" name="normal-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="경쟁" name="ranked-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="사용자 지정" name="custom-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
