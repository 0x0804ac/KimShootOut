<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-panel" style="flex-grow: 1; margin-top: 60px; margin-right: 60px; margin-bottom: 60px; margin-left: 60px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; -unity-text-align: middle-center;">
        <ui:Label text="Shoot-Out" name="title-label" style="justify-content: center; align-content: center; font-size: 144px; margin-left: 4px; margin-bottom: 400px; margin-top: 100px; margin-right: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;"/>
        <ui:GroupBox name="button-group" style="margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
            <ui:Button text="싱글플레이" name="singleplayer-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="멀티플레이" name="multiplayer-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="커스터마이즈" name="customize-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="설정" name="settings-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="제작진" name="credits-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
