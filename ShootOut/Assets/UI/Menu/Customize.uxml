<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/UIStyleSheet.uss?fileID=7433441132597879392&amp;guid=e41e4252b4a52fa4c8696002518a7295&amp;type=3#UIStyleSheet"/>
    <ui:VisualElement name="main-panel" style="flex-grow: 1; margin-top: 60px; margin-right: 60px; margin-bottom: 60px; margin-left: 60px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; -unity-text-align: middle-center;">
        <ui:VisualElement name="back-button-panel" style="flex-grow: 1; flex-direction: row; height: 200px; max-height: 200px; min-height: 108px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;">
            <ui:Button name="back-button" style="background-image: url(&quot;project://database/Assets/Assets/UI%20Elements/White/2x/left.png?fileID=2800000&amp;guid=ebd50b12e871e0142afe371f911d8eb2&amp;type=3#left&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100px; height: 100px; aspect-ratio: 1; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
        <ui:Label text="Shoot-Out" name="title-label" style="justify-content: center; align-content: center; font-size: 144px; margin-left: 4px; margin-bottom: 200px; margin-top: 100px; margin-right: 4px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;"/>
        <ui:Label text="커스터마이즈" name="menu-label" style="padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; font-size: 108px; margin-left: 4px; margin-bottom: 100px;"/>
        <ui:GroupBox name="button-group" style="margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
            <ui:Button text="선수" name="player-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="효과" name="effect-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
            <ui:Button text="프로필" name="profile-button" style="font-size: 72px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-top: 40px; margin-right: 4px; margin-bottom: 40px; margin-left: 4px;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
