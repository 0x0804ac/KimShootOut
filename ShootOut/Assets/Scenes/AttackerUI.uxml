<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AttackerUI.uss?fileID=7433441132597879392&amp;guid=a42d7049e045f5542a9d966f78691ed7&amp;type=3#AttackerUI"/>
    <ui:GroupBox name="Box" style="bottom: auto; transform-origin: bottom; height: 60%; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-right: 5px; padding-left: 5px; flex-direction: column; flex-wrap: nowrap; top: 30%; left: auto; right: auto; align-self: auto;">
        <ui:VisualElement name="Panel" style="flex-grow: 1; align-items: stretch; align-self: stretch; align-content: stretch; bottom: auto; right: auto; left: auto; transform-origin: center; height: auto;">
            <ui:VisualElement name="ButtonBound" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.251); justify-content: center; align-items: auto; align-content: center;">
                <ui:Button text="방향" name="DirectionButton" style="align-items: center; align-self: center; align-content: center;"/>
            </ui:VisualElement>
            <ui:Slider label="파워" value="50" high-value="100" name="PowerSlider" fill="true" show-input-field="false" style="transform-origin: center; white-space: normal; -unity-text-align: upper-left; text-overflow: clip; -unity-text-generator: standard; -unity-text-auto-size: none; flex-wrap: nowrap; align-items: auto; justify-content: flex-start; align-self: auto; align-content: auto;"/>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
